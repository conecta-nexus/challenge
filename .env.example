# ==============================================================================
# Conecta Nexus - Challenge Microservice Environment Configuration
# ==============================================================================

# Database connection URL (PostgreSQL with asyncpg driver)
# Container network default: postgres:5432
# Local host default: localhost:5432
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/db_challenges

# Database query logging
DB_ECHO=false

# Application environment (development, testing, production)
APP_ENV=development

# Server host and port
HOST=0.0.0.0
PORT=8000

# MinIO / S3-compatible object storage
# Container network default: minio:9000
# Local host default: localhost:9000
# The Python MinIO SDK expects host:port without http:// or https://.
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=conectaadmin
STORAGE_SECRET_KEY=change-this-storage-secret
STORAGE_BUCKET=challenge-attachments
STORAGE_SECURE=false
STORAGE_REGION=us-east-1
STORAGE_POOL_MAX_SIZE=20
STORAGE_PART_SIZE_BYTES=10485760
STORAGE_AUTO_CREATE_BUCKET=true

# Cryptographic public key for RS256 JWT verification (ADR-002)
JWT_PUBLIC_KEY_PATH=certs/jwt_public.pem
